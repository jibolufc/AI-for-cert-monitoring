{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/enterprise-catalog.schema.json",
  "title": "Enterprise cryptographic migration catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "name", "as_of", "evidence_level", "scope", "owners", "services"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalog_id": {"type": "string", "format": "uuid"},
    "catalog_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "as_of": {"type": "string", "format": "date-time"},
    "evidence_level": {"enum": ["simulated", "sanitised-capture", "authenticated-production", "independently-verified"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_asset_ids", "in_scope_asset_ids", "out_of_scope_asset_ids"],
      "properties": {
        "known_asset_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "in_scope_asset_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "out_of_scope_asset_ids": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "owners": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["owner_id", "display_name", "role"],
        "properties": {
          "owner_id": {"$ref": "#/$defs/id"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
          "role": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "services": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/service"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["service_id", "asset_id", "name", "owner_id", "requested_by", "environment", "business_criticality", "data_classification", "protection_lifetime_months", "supplier", "dependencies", "cryptographic_uses"],
      "properties": {
        "service_id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner_id": {"$ref": "#/$defs/id"},
        "requested_by": {"$ref": "#/$defs/id"},
        "environment": {"enum": ["production", "staging", "development"]},
        "business_criticality": {"enum": ["low", "medium", "high", "critical", "unknown"]},
        "data_classification": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]},
        "protection_lifetime_months": {"type": ["integer", "null"], "minimum": 0, "maximum": 1200},
        "supplier": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "product", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "product": {"type": "string", "minLength": 1, "maxLength": 256},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "dependencies": {
          "type": "array", "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["service_id", "type"],
            "properties": {
              "service_id": {"$ref": "#/$defs/id"},
              "type": {"enum": ["hard", "soft"]}
            }
          }
        },
        "cryptographic_uses": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {"$ref": "#/$defs/cryptographicUse"}
        }
      }
    },
    "cryptographicUse": {
      "type": "object", "additionalProperties": false,
      "required": ["use_id", "inventory_record_id", "function", "protocol", "current_algorithm_family", "exposure_status", "evidence_status", "evidence_level", "target_state"],
      "properties": {
        "use_id": {"$ref": "#/$defs/id"},
        "inventory_record_id": {"type": ["string", "null"], "format": "uuid"},
        "function": {"enum": ["key-establishment", "digital-signature", "certificate-authentication"]},
        "protocol": {"type": "string", "minLength": 1, "maxLength": 128},
        "current_algorithm_family": {"enum": ["rsa", "elliptic-curve", "finite-field-dh", "ml-kem", "ml-dsa", "slh-dsa", "hybrid", "other", "unknown"]},
        "exposure_status": {"enum": ["quantum-vulnerable", "candidate-quantum-resistant", "hybrid-unverified", "unknown"]},
        "evidence_status": {"enum": ["current", "stale", "missing"]},
        "evidence_level": {"enum": ["simulated", "generated", "public-observation", "sanitised-capture", "authenticated-production", "independently-verified"]},
        "target_state": {
          "type": "object", "additionalProperties": false,
          "required": ["algorithm_family", "algorithm_name", "standard", "readiness"],
          "properties": {
            "algorithm_family": {"enum": ["ml-kem", "ml-dsa", "slh-dsa", "hybrid", "unknown"]},
            "algorithm_name": {"type": "string", "minLength": 1, "maxLength": 128},
            "standard": {"type": "string", "minLength": 1, "maxLength": 128},
            "readiness": {"enum": ["supported", "planned", "unsupported", "unknown"]}
          }
        }
      }
    }
  }
}
