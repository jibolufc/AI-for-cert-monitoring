{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/detection-alert.schema.json",
  "title": "Certificate detection alert",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alert_id", "rule_id", "event_id", "created_at", "severity", "risk_score", "title", "evidence", "policy", "explanation", "explanation_authority", "playbook"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "alert_id": {"type": "string", "format": "uuid"},
    "rule_id": {"const": "CERT-001"},
    "event_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["medium", "high"]},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "title": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint_sha256", "source_type", "source_id", "issuer", "subject", "all_dns_names", "unmatched_dns_names", "environment", "source_evidence", "event_provenance"],
      "properties": {
        "fingerprint_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "source_type": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "subject": {"type": "string"},
        "all_dns_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "unmatched_dns_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "environment": {"type": "string"},
        "source_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_by", "collected_at"],
          "properties": {
            "observed_by": {"type": "string", "minLength": 1, "maxLength": 256},
            "collected_at": {"type": "string", "format": "date-time"},
            "uri": {"type": "string", "format": "uri", "maxLength": 2048}
          }
        },
        "event_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collector_id", "collector_version", "source_record_id", "payload_sha256", "verification_state", "cursor"],
          "properties": {
            "collector_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "collector_version": {"type": "string", "minLength": 1, "maxLength": 32},
            "source_record_id": {"type": "string", "minLength": 1, "maxLength": 512},
            "payload_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "verification_state": {"enum": ["verified", "unverified", "failed"]},
            "cursor": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy_version": {"type": "integer", "minimum": 1}
      }
    },
    "explanation": {"type": "string", "minLength": 1},
    "explanation_authority": {"const": "advisory-only"},
    "playbook": {"const": "docs/soc-playbooks/CERT-001-unknown-domain.md"}
  }
}
