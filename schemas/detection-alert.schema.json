{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/detection-alert.schema.json",
  "title": "Certificate detection alert",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alert_id", "rule_id", "event_id", "created_at", "severity", "risk_score", "title", "evidence", "explanation", "explanation_authority", "playbook"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "alert_id": {"type": "string", "format": "uuid"},
    "rule_id": {"const": "CERT-001"},
    "event_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["medium", "high"]},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "title": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint_sha256", "source_type", "source_id", "issuer", "subject", "all_dns_names", "unmatched_dns_names", "environment", "source_evidence"],
      "properties": {
        "fingerprint_sha256": {"type": "string"},
        "source_type": {"type": "string"},
        "source_id": {"type": "string"},
        "issuer": {"type": "string"},
        "subject": {"type": "string"},
        "all_dns_names": {"type": "array", "items": {"type": "string"}},
        "unmatched_dns_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "environment": {"type": "string"},
        "source_evidence": {"type": "object"}
      }
    },
    "explanation": {"type": "string", "minLength": 1},
    "explanation_authority": {"const": "advisory-only"},
    "playbook": {"const": "docs/soc-playbooks/CERT-001-unknown-domain.md"}
  }
}
