{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/migration-verification.schema.json",
  "title": "PQC migration verification record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "work_item_id", "work_item_version", "verified_at", "verifier", "target_state", "pre_change_evidence_refs", "post_change_evidence_refs", "checks", "residual_findings", "conclusion"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "verification_id": {"type": "string", "format": "uuid"},
    "work_item_id": {"type": "string", "format": "uuid"},
    "work_item_version": {"type": "integer", "minimum": 1},
    "verified_at": {"type": "string", "format": "date-time"},
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "independence"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "independence": {"enum": ["internal-independent", "external-independent"]}
      }
    },
    "target_state": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm_family", "algorithm_name", "standard", "readiness"],
      "properties": {
        "algorithm_family": {"enum": ["ml-kem", "ml-dsa", "slh-dsa", "hybrid", "unknown"]},
        "algorithm_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "standard": {"type": "string", "minLength": 1, "maxLength": 128},
        "readiness": {"enum": ["supported", "planned", "unsupported", "unknown"]}
      }
    },
    "pre_change_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "post_change_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "result", "evidence_ref"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "result": {"enum": ["pass", "fail"]},
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "residual_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "conclusion": {"enum": ["verified", "failed", "inconclusive"]}
  }
}
