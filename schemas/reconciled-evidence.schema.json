{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reconciled-evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reconciliation_id", "identity_key", "as_of", "canonical_record_id", "observation_record_ids", "status", "conflicts", "evidence_level", "decision_authority"],
  "properties": {
    "schema_version": {"const": "1.0"}, "reconciliation_id": {"type": "string", "format": "uuid"},
    "identity_key": {"type": "string", "minLength": 1}, "as_of": {"type": "string", "format": "date-time"},
    "canonical_record_id": {"type": "string", "format": "uuid"},
    "observation_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "status": {"enum": ["consistent", "conflicted"]},
    "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["state", "record_ids"], "properties": {"state": {"type": "string"}, "record_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}}}}},
    "evidence_level": {"enum": ["simulated", "generated", "public-observation", "sanitised-capture", "authenticated-production", "independently-verified"]},
    "decision_authority": {"const": "deterministic-advisory"}
  }
}
