{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/pilot-authorisation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authorisation_id", "requested_by", "approved_by", "source_id", "mode", "asset_ids", "valid_from", "expires_at", "authenticated_source", "evidence_level", "stop_conditions"],
  "properties": {
    "schema_version": {"const": "1.0"}, "authorisation_id": {"type": "string", "format": "uuid"},
    "requested_by": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1},
    "mode": {"const": "read-only"}, "asset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "valid_from": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "authenticated_source": {"type": "boolean"}, "evidence_level": {"enum": ["simulated", "sanitised-capture", "authenticated-production"]},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
