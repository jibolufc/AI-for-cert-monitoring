{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ct-observation-page.schema.json",
  "title": "Decoded Certificate Transparency observation page",
  "description": "Provider-neutral decoded fixture contract; not an RFC 6962 or RFC 9162 wire response.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "log_id", "page_after_cursor", "next_cursor", "collected_at", "entries"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "log_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "page_after_cursor": {"type": ["string", "null"], "maxLength": 256},
    "next_cursor": {"type": "string", "minLength": 1, "maxLength": 256},
    "collected_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "observed_at", "source_uri", "certificate", "cryptography"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_uri": {"type": "string", "format": "uri", "maxLength": 2048},
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprint_sha256", "serial_number", "subject", "issuer", "san_dns_names", "not_before", "not_after"],
          "properties": {
            "fingerprint_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "serial_number": {"type": "string", "minLength": 1, "maxLength": 128},
            "subject": {"type": "string", "maxLength": 2048},
            "issuer": {"type": "string", "minLength": 1, "maxLength": 2048},
            "san_dns_names": {
              "type": "array",
              "minItems": 0,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 253}
            },
            "not_before": {"type": "string", "format": "date-time"},
            "not_after": {"type": "string", "format": "date-time"}
          }
        },
        "cryptography": {"$ref": "#/$defs/cryptography"}
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "name", "oid"],
      "properties": {
        "family": {"enum": ["rsa", "elliptic-curve", "finite-field-dh", "dsa", "ml-kem", "ml-dsa", "slh-dsa", "hybrid", "other", "unknown"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "oid": {"type": "string", "pattern": "^(unknown|[0-9]+(?:\\.[0-9]+)+)$", "maxLength": 128},
        "key_size_bits": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "curve": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "signatureAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "name", "oid"],
      "properties": {
        "family": {"enum": ["rsa", "elliptic-curve", "dsa", "ml-dsa", "slh-dsa", "hybrid", "other", "unknown"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "oid": {"type": "string", "pattern": "^(unknown|[0-9]+(?:\\.[0-9]+)+)$", "maxLength": 128},
        "hash_algorithm": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "cryptography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_key", "certificate_signature", "key_usage", "extended_key_usage"],
      "properties": {
        "public_key": {"$ref": "#/$defs/algorithm"},
        "certificate_signature": {"$ref": "#/$defs/signatureAlgorithm"},
        "key_usage": {"type": "array", "uniqueItems": true, "items": {"enum": ["digital-signature", "content-commitment", "key-encipherment", "data-encipherment", "key-agreement", "key-cert-sign", "crl-sign", "encipher-only", "decipher-only", "unknown"]}},
        "extended_key_usage": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    }
  }
}
