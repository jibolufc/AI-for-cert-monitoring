{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/migration-exception.schema.json",
  "title": "Time-bounded PQC migration exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exception_id", "work_item_id", "work_item_version", "status", "risk_owner_id", "approved_by", "approved_at", "expires_at", "rationale", "compensating_controls", "review_cadence_days"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "exception_id": {"type": "string", "format": "uuid"},
    "work_item_id": {"type": "string", "format": "uuid"},
    "work_item_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["active", "expired", "revoked"]},
    "risk_owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
    "compensating_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "review_cadence_days": {"type": "integer", "minimum": 1, "maximum": 365}
  }
}
