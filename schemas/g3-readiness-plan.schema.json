{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/g3-readiness-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "environment", "requested_by", "approved_by",
    "source_id", "collection_mode", "asset_ids", "valid_from", "expires_at",
    "authenticated_source", "evidence_level", "data_classification",
    "retention_days", "privacy_review", "security_review", "real_data_enabled",
    "authorisation_reference", "stop_conditions", "prohibited_operations", "controls"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "format": "uuid"},
    "environment": {"enum": ["synthetic-staging", "authorised-pilot"]},
    "requested_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "collection_mode": {"const": "read-only"},
    "asset_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authenticated_source": {"type": "boolean"},
    "evidence_level": {"enum": ["simulated", "sanitised-capture", "authenticated-production"]},
    "data_classification": {"enum": ["synthetic", "public", "internal", "confidential", "restricted"]},
    "retention_days": {"type": "integer", "minimum": 0, "maximum": 365},
    "privacy_review": {"enum": ["not-required-synthetic", "pending", "approved", "rejected"]},
    "security_review": {"enum": ["pending", "approved", "rejected"]},
    "real_data_enabled": {"type": "boolean"},
    "authorisation_reference": {"type": ["string", "null"], "minLength": 1},
    "stop_conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["trigger", "action", "owner"],
        "properties": {
          "trigger": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "prohibited_operations": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["issue", "revoke", "rotate", "delete", "deploy", "change-trust", "execute"]}
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": [
        "workload_identity", "least_privilege_rbac", "private_networking",
        "encryption", "secret_management", "central_logging",
        "deployment_controls", "backup_restore"
      ],
      "properties": {
        "workload_identity": {"$ref": "#/$defs/control"},
        "least_privilege_rbac": {"$ref": "#/$defs/control"},
        "private_networking": {"$ref": "#/$defs/control"},
        "encryption": {"$ref": "#/$defs/control"},
        "secret_management": {"$ref": "#/$defs/control"},
        "central_logging": {"$ref": "#/$defs/control"},
        "deployment_controls": {"$ref": "#/$defs/control"},
        "backup_restore": {"$ref": "#/$defs/control"}
      }
    }
  },
  "$defs": {
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"enum": ["demonstrated", "planned", "not-applicable"]},
        "evidence_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "approved_by": {
          "type": "string", "minLength": 1, "maxLength": 256,
          "description": "Identity that accepted a not-applicable disposition. Must differ from the plan requester."
        }
      }
    }
  }
}
