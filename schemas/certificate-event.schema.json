{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/certificate-event.schema.json",
  "title": "Canonical certificate event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "observed_at", "source", "certificate", "cryptography", "context", "evidence", "provenance"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["certificate.issued", "certificate.observed"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["fixture", "ct", "acme", "tls", "aws-acm", "azure-key-vault", "gcp-certificate-manager", "cert-manager", "vault", "adcs"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "certificate": {"$ref": "#/$defs/certificate"},
    "cryptography": {"$ref": "#/$defs/cryptography"},
    "context": {
      "type": "object", "additionalProperties": false, "required": ["environment"],
      "properties": {
        "environment": {"enum": ["production", "staging", "development", "unknown"]},
        "account": {"type": "string", "maxLength": 256},
        "region": {"type": "string", "maxLength": 128},
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "service_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "business_criticality": {"enum": ["low", "medium", "high", "critical", "unknown"]},
        "data_classification": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]},
        "protection_lifetime_months": {"type": "integer", "minimum": 0, "maximum": 1200}
      }
    },
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "certificate": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint_sha256", "serial_number", "subject", "issuer", "san_dns_names", "not_before", "not_after"],
      "properties": {
        "fingerprint_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "serial_number": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject": {"type": "string", "maxLength": 2048},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 2048},
        "san_dns_names": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"}
      }
    },
    "algorithm": {
      "type": "object", "additionalProperties": false, "required": ["family", "name", "oid"],
      "properties": {
        "family": {"enum": ["rsa", "elliptic-curve", "finite-field-dh", "ml-kem", "ml-dsa", "slh-dsa", "hybrid", "other", "unknown"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "oid": {"type": "string", "pattern": "^(unknown|[0-9]+(?:\\.[0-9]+)+)$", "maxLength": 128},
        "key_size_bits": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "curve": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "signatureAlgorithm": {
      "type": "object", "additionalProperties": false, "required": ["family", "name", "oid"],
      "properties": {
        "family": {"enum": ["rsa", "elliptic-curve", "ml-dsa", "slh-dsa", "hybrid", "other", "unknown"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "oid": {"type": "string", "pattern": "^(unknown|[0-9]+(?:\\.[0-9]+)+)$", "maxLength": 128},
        "hash_algorithm": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "cryptography": {
      "type": "object", "additionalProperties": false,
      "required": ["public_key", "certificate_signature", "key_usage", "extended_key_usage"],
      "properties": {
        "public_key": {"$ref": "#/$defs/algorithm"},
        "certificate_signature": {"$ref": "#/$defs/signatureAlgorithm"},
        "key_usage": {"type": "array", "uniqueItems": true, "items": {"enum": ["digital-signature", "content-commitment", "key-encipherment", "data-encipherment", "key-agreement", "key-cert-sign", "crl-sign", "encipher-only", "decipher-only", "unknown"]}},
        "extended_key_usage": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["observed_by", "collected_at"],
      "properties": {
        "observed_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "collected_at": {"type": "string", "format": "date-time"},
        "uri": {"type": "string", "format": "uri", "maxLength": 2048}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["collector_id", "collector_version", "source_record_id", "payload_sha256", "verification_state", "cursor"],
      "properties": {
        "collector_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "collector_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "source_record_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "payload_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "verification_state": {"enum": ["verified", "unverified", "failed"]},
        "cursor": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
